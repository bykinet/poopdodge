rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User character files: user-characters/{uid}/{fileName}
    // Users can only read and write files within their own uid folder
    match /user-characters/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public game assets and brand assets
    match /game-assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
